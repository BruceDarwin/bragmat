platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # iOS-3C (Apple 91011): strip arm64e from libsodium's vendored xcframework
  # inside the Pods-Runner aggregate target, BEFORE its '[CP] Copy
  # XCFrameworks' phase stages the slice into XCFrameworkIntermediates.
  # Runner's '[CP] Embed Pods Frameworks' later embeds+codesigns the staged
  # (already-stripped) copy, so the framework signature covers the correct
  # binary. Same-target phase ordering is deterministic — Runner-level
  # phases cannot be used because Pods-Runner is a target DEPENDENCY that
  # completes before any Runner phase. libsodium-only; fails loudly if the
  # framework is absent; idempotent via phase-name check; survives pod
  # install because it lives in the Podfile.
  phase_name = 'Strip libsodium arm64e'
  # Locate the target that actually owns '[CP] Copy XCFrameworks' — may be
  # the sodium_libs pod target or the aggregate; do not assume. Fail loudly
  # rather than injecting at an unverified position.
  owner = installer.pods_project.targets.find do |t|
    t.shell_script_build_phases.any? { |p| p.name == '[CP] Copy XCFrameworks' }
  end
  raise 'No target with [CP] Copy XCFrameworks found — cannot order the libsodium strip' unless owner
  Pod::UI.puts "iOS-3C: injecting '#{phase_name}' into target '#{owner.name}' before '[CP] Copy XCFrameworks'"

  unless owner.shell_script_build_phases.any? { |p| p.name == phase_name }
    phase = owner.new_shell_script_build_phase(phase_name)
    phase.shell_script = <<~'SH'
      set -e
      # SRCROOT for this aggregate target is ios/Pods — the plugin source
      # resolves via ../.symlinks/plugins/... (symlink to the pub-cache copy).
      XCF="${SRCROOT}/../.symlinks/plugins/sodium_libs/darwin/Libraries/libsodium.xcframework"
      [ -d "$XCF" ] || XCF=$(find "${SRCROOT}/../.symlinks" "${SRCROOT}" \
        -type d -name "libsodium.xcframework" 2>/dev/null | head -1)
      # libsodium is required — a missing framework fails the build.
      [ -d "$XCF" ] || { echo "libsodium.xcframework not found — cannot verify arm64e removal"; exit 1; }
      find "$XCF" -name libsodium -type f | while read -r bin; do
        ARCHS=$(lipo -archs "$bin")
        if echo "$ARCHS" | tr ' ' '\n' | grep -qx arm64e; then
          lipo -remove arm64e "$bin" -o "$bin"
        fi
        lipo -archs "$bin" | tr ' ' '\n' | grep -qx arm64 \
          || { echo "libsodium arm64 missing in $bin"; exit 1; }
      done
    SH
    copy_idx = owner.build_phases.index do |p|
      p.respond_to?(:name) && p.name == '[CP] Copy XCFrameworks'
    end
    raise '[CP] Copy XCFrameworks found on target but phase index missing' if copy_idx.nil?
    owner.build_phases.delete(phase)
    owner.build_phases.insert(copy_idx, phase)
  end
end
