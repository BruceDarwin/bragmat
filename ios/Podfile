platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # iOS-3C hook moved to post_integrate (see below): '[CP] Copy
  # XCFrameworks' is a USER-PROJECT integration phase on the Runner app
  # target — it does not exist in pods_project and is only created after
  # the user project is integrated, i.e. during post_integrate.
end

# iOS-3C (Apple 91011): strip arm64e from libsodium's vendored xcframework
# before Runner's '[CP] Copy XCFrameworks' phase stages the selected slice
# into XCFrameworkIntermediates; '[CP] Embed Pods Frameworks' later embeds
# AND codesigns the staged (already-stripped) .framework — signature valid.
# Same-target ordering inside Runner is deterministic. Fails loudly if the
# phase/framework is absent; idempotent via phase-name check; persisted in
# the Podfile across pod install runs.
post_integrate do |installer|
  phase_name = 'Strip libsodium arm64e'
  project_path = File.expand_path('Runner.xcodeproj', File.dirname(__FILE__))
  project = Xcodeproj::Project.open(project_path)
  runner = project.targets.find { |t| t.name == 'Runner' }
  raise 'Runner target not found' unless runner

  copy_phases = runner.shell_script_build_phases.select do |p|
    p.name == '[CP] Copy XCFrameworks'
  end

  # This CocoaPods version has NO separate '[CP] Copy XCFrameworks' phase:
  # xcframework staging (slice-select + copy) happens inside '[CP] Embed
  # Pods Frameworks', which also codesigns the embedded framework. If a
  # copy phase ever appears, prefer it; otherwise target the embed phase.
  target_phases = copy_phases.empty? ?
    runner.shell_script_build_phases.select { |p| p.name == '[CP] Embed Pods Frameworks' } :
    copy_phases
  raise 'No [CP] xcframework staging/embed phase on Runner target' if target_phases.empty?

  # Match the phase whose generated script stages libsodium.xcframework —
  # the phase's shell_script invokes Pods/Target Support Files/…/*.sh.
  pods_root = File.expand_path('Pods', File.dirname(__FILE__))
  copy_phase = target_phases.find do |p|
    ref = p.shell_script.to_s[/["']([^"']*\.sh)["']/, 1] ||
          p.shell_script.to_s[/([^\s"']*\.sh)/, 1]
    rel = ref&.sub('${PODS_ROOT}', '')&.sub(%r{^/}, '')
    path = rel && File.join(pods_root, rel)
    Pod::UI.puts "iOS-3C: candidate phase #{p.name.inspect} ref=#{ref.inspect} resolved=#{path.inspect} exists=#{path && File.exist?(path)}"
    path && File.exist?(path) && File.read(path).include?('libsodium.xcframework')
  end
  raise 'No [CP] script references libsodium.xcframework' unless copy_phase

  unless runner.shell_script_build_phases.any? { |p| p.name == phase_name }
    phase = runner.new_shell_script_build_phase(phase_name)
    phase.shell_script = <<~'SH'
      set -e
      XCF="${SRCROOT}/.symlinks/plugins/sodium_libs/darwin/Libraries/libsodium.xcframework"
      [ -d "$XCF" ] || XCF=$(find "${SRCROOT}" -type d -name "libsodium.xcframework" | head -1)
      [ -d "$XCF" ] || { echo "libsodium.xcframework not found — cannot verify arm64e removal"; exit 1; }
      find "$XCF" -name libsodium -type f | while read -r bin; do
        ARCHS=$(lipo -archs "$bin")
        if echo "$ARCHS" | tr ' ' '\n' | grep -qx arm64e; then
          lipo -remove arm64e "$bin" -o "$bin"
        fi
        lipo -archs "$bin" | tr ' ' '\n' | grep -qx arm64 \
          || { echo "libsodium arm64 missing in $bin"; exit 1; }
      done
    SH
    runner.build_phases.delete(phase)
    runner.build_phases.insert(runner.build_phases.index(copy_phase), phase)
    project.save
    Pod::UI.puts "iOS-3C: injected '#{phase_name}' before '[CP] Copy XCFrameworks' on Runner"
  end
end
