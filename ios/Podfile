platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # iOS-3C hook moved to post_integrate (see below): '[CP] Copy
  # XCFrameworks' is a USER-PROJECT integration phase on the Runner app
  # target — it does not exist in pods_project and is only created after
  # the user project is integrated, i.e. during post_integrate.
end

# iOS-3C (Apple 91011): strip arm64e from libsodium's vendored xcframework
# before Runner's '[CP] Copy XCFrameworks' phase stages the selected slice
# into XCFrameworkIntermediates; '[CP] Embed Pods Frameworks' later embeds
# AND codesigns the staged (already-stripped) .framework — signature valid.
# Same-target ordering inside Runner is deterministic. Fails loudly if the
# phase/framework is absent; idempotent via phase-name check; persisted in
# the Podfile across pod install runs.
post_integrate do |installer|
  # iOS-3C (Apple 91011): strip the stale arm64e slice from libsodium's
  # vendored xcframework in the EARLIEST Runner build phase — position 1,
  # immediately after '[CP] Check Pods Manifest.lock'. Every downstream
  # mechanism that copies/embeds the framework (whichever it is) then sees
  # the already-stripped source, and the phase that embeds it signs the
  # stripped binary. No CocoaPods script-content matching — the embed path
  # proved not to expose a libsodium-named script. Fails loudly if the
  # Runner target, insertion anchor or framework is absent; idempotent.
  phase_name = 'Strip libsodium arm64e'
  project = Xcodeproj::Project.open(File.expand_path('Runner.xcodeproj', File.dirname(__FILE__)))
  runner = project.targets.find { |t| t.name == 'Runner' }
  raise 'iOS-3C: Runner target not found' unless runner
  anchor = runner.build_phases.index do |p|
    p.respond_to?(:name) && p.name == '[CP] Check Pods Manifest.lock'
  end
  raise 'iOS-3C: [CP] Check Pods Manifest.lock anchor phase not found' if anchor.nil?

  unless runner.shell_script_build_phases.any? { |p| p.name == phase_name }
    phase = runner.new_shell_script_build_phase(phase_name)
    phase.shell_script = <<~'SH'
      # iOS-3C diagnostic: evidence written outside Runner.app, collected
      # as a build artifact. Records phase execution, resolved paths,
      # archs + sha256 before/after, and whether the embedded framework
      # already exists. No secrets/signing material logged.
      EV="${SRCROOT}/build/strip_evidence.log"
      {
        echo "PHASE_EXECUTED config=${CONFIGURATION} target=${TARGET_NAME} platform=${PLATFORM_NAME}"
        echo "SRCROOT=${SRCROOT} BUILT_PRODUCTS_DIR=${BUILT_PRODUCTS_DIR}"
        XCF="${SRCROOT}/.symlinks/plugins/sodium_libs/darwin/Libraries/libsodium.xcframework"
        [ -d "$XCF" ] || XCF=$(find "${SRCROOT}" -type d -name "libsodium.xcframework" | head -1)
        echo "XCF=${XCF:-NOT_FOUND}"
        EMB="${BUILT_PRODUCTS_DIR}/${FRAMEWORKS_FOLDER_PATH}/libsodium.framework/libsodium"
        [ -f "$EMB" ] && echo "embedded_exists=true path=$EMB" || echo "embedded_exists=false path=$EMB"
        [ -n "$XCF" ] && [ -d "$XCF" ] && find "$XCF" -name libsodium -type f | while read -r bin; do
          echo "before: $bin -> $(lipo -archs "$bin") sha=$(shasum -a 256 "$bin" | cut -d' ' -f1)"
        done
      } >> "$EV" 2>&1
      set -e
      [ -d "$XCF" ] || { echo "libsodium.xcframework not found — cannot verify arm64e removal" | tee -a "$EV"; exit 1; }
      find "$XCF" -name libsodium -type f | while read -r bin; do
        if lipo -archs "$bin" | tr ' ' '\n' | grep -qx arm64e; then
          lipo -remove arm64e "$bin" -o "$bin"
        fi
        lipo -archs "$bin" | tr ' ' '\n' | grep -qx arm64 \
          || { echo "libsodium arm64 missing in $bin" | tee -a "$EV"; exit 1; }
        echo "after:  $bin -> $(lipo -archs "$bin") sha=$(shasum -a 256 "$bin" | cut -d' ' -f1)" >> "$EV"
      done
    SH
    runner.build_phases.delete(phase)
    runner.build_phases.insert(anchor + 1, phase)
    project.save
    Pod::UI.puts "iOS-3C: injected '#{phase_name}' at Runner phase #{anchor + 1}"
  end
end
