platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # iOS-3C (Apple 91011): the prebuilt libsodium xcframework ships an arm64e
  # slice compiled with an SDK too old for App Store upload. Strip arm64e
  # from the framework the build actually embeds — a Run Script phase placed
  # BEFORE '[CP] Embed Pods Frameworks', which copies AND codesigns the
  # framework, so the signature covers the stripped binary. Restricted to
  # libsodium; preserves arm64; idempotent via phase-name check; survives
  # pod install because it lives in the Podfile.
  phase_name = 'Strip libsodium arm64e'
  runner_project = Xcodeproj::Project.open('Runner.xcodeproj')
  runner_target = runner_project.targets.find { |t| t.name == 'Runner' }
  raise 'Runner target not found in Runner.xcodeproj' unless runner_target

  unless runner_target.shell_script_build_phases.any? { |p| p.name == phase_name }
    phase = runner_target.new_shell_script_build_phase(phase_name)
    phase.shell_script = <<~'SH'
      set -e
      XCF="${SRCROOT}/.symlinks/plugins/sodium_libs/darwin/Libraries/libsodium.xcframework"
      [ -d "$XCF" ] || XCF=$(find "${SRCROOT}/Pods" -type d -name "libsodium.xcframework" | head -1)
      # libsodium is a required dependency — a missing framework must fail
      # the build, never silently skip the arm64e correction.
      [ -d "$XCF" ] || { echo "libsodium.xcframework not found — cannot verify arm64e removal"; exit 1; }
      find "$XCF" -name libsodium -type f | while read -r bin; do
        ARCHS=$(lipo -archs "$bin")
        if echo "$ARCHS" | tr ' ' '\n' | grep -qx arm64e; then
          lipo -remove arm64e "$bin" -o "$bin"
        fi
        lipo -archs "$bin" | tr ' ' '\n' | grep -qx arm64 \
          || { echo "libsodium arm64 missing in $bin"; exit 1; }
      done
    SH
    embed_idx = runner_target.build_phases.index do |p|
      p.respond_to?(:name) && p.name == '[CP] Embed Pods Frameworks'
    end
    runner_target.build_phases.delete(phase)
    runner_target.build_phases.insert(embed_idx || 1, phase)
    runner_project.save
  end
end
