<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+ dark-mode variant: identical splash configuration, the
         approved branding uses the same Deep Ocean background in both
         light and dark device modes. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/bragmat_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/bragmat_splash_background</item>
    </style>
</resources>
