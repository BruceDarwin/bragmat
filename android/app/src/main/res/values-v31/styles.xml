<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 31+: the system splash screen renders the icon inside its own
         circular mask. The adaptive-icon foreground is illustration-only
         artwork verified to fit the 66/108 safe circle, so it survives the
         splash mask without clipping. Background and icon backplate share
         the approved Deep Ocean colour. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/bragmat_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/bragmat_splash_background</item>
    </style>
</resources>
