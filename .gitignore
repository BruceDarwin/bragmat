#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Environment secrets (use --dart-define; never commit real values)
.env
.env.local

# Local device snapshots and verification scratch files
device_snapshots/
tool/verify_*_tmp.dart

# Tide-station verification/discovery reports (may contain WorldTides
